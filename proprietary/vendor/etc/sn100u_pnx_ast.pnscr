// CORE_CONF_EXTN
send 20020D03A0EC0101A0ED0101A00A0120

// CORE_CONF
send 200237112801002101003001083101033201603801013304010203045401065001025B01003E010080010181010182010E180101680101850101

# AST Test Command
// NCI SYSTEM ENABLE PROPRIETARY CMD
send 2F0200

// NCI Disable standby mode
send 2F000100

// DISABLE DPC
send 2F3F03700201

// FORCE A SPECIFIC VDDPA VALUE for AST (Set VDDPA)
send 2F3F03700122

// Antenna Self Test loop 1 and 2
// START CONTINUOUS RF ON (RF ON for AST)
send 2F3F03320200

// READ RSSI AST1 (AST loop1)
trigger 4F3203
send 2F320208FF

// READ RSSI AST2 (AST loop2)
trigger 4F320B
send 2F320220FF

// Read VDDPA VALUE (Read VDDPA)
send 2F3F03700000

// STOP CONTINUOUS RF ON (RF OFF for AST)
send 2F3F03320000

// NCI Enable standby mode
send 2F000101
